# Copy to .env for local work. NEVER commit the real .env (it is git-ignored).
# Check your values any time with:  python -m scripts.check_env      (never prints secrets)

# ───────────── REQUIRED ─────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# At least 32 characters; the app refuses to start in production with less.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ───────────── Email (needed for admin 2FA codes + password resets) ─────────────
# Option A (recommended on Render - uses HTTPS, SMTP ports may be blocked):
RESEND_API_KEY=
EMAIL_FROM=AI Hiring System <onboarding@resend.dev>
# Option B: Gmail SMTP with an App Password
ADMIN_EMAIL=
ADMIN_EMAIL_PASSWORD=

# ───────────── Chat assistant (set one; Claude is used first) ─────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ───────────── Who runs the service (shown in the legal pages and email footers) ─────────────
OPERATOR_NAME=Allan Kamau
OPERATOR_LOCATION=Nairobi, Kenya
CONTACT_EMAIL=                    # REQUIRED before going live: where people send privacy requests. Also set it in the Streamlit secrets.
API_PUBLIC_URL=                   # your Render URL, e.g. https://my-api.onrender.com  (enables one-click unsubscribe in email clients)

# ───────────── Optional ─────────────
ENVIRONMENT=production            # production | development | test
FRONTEND_URL=https://ai-powered-hiring-system.streamlit.app
# CORS: leave EMPTY to allow only FRONTEND_URL (recommended). Or list origins: https://a.example,https://b.example
CORS_ORIGINS=
ENABLE_DOCS=                      # empty = /docs only outside production. Set true to expose it on purpose.
ALLOWED_HOSTS=                    # optional Host allow-list, e.g. my-api.onrender.com
OTP_DELIVERY=email                # email | log (log = print code in server logs; break-glass only)
TRUSTED_PROXY_HOPS=1              # raise to 2 if /admin/client-ip shows the same IP for everyone
LOGIN_MAX_FAILURES=5              # wrong passwords per (email + IP) before a 15 minute lock
LOGIN_LOCKOUT_MINUTES=15
MAX_UPLOAD_MB=5
CHAT_DAILY_LIMIT=1000             # all visitors together
CHAT_PER_IP_DAILY_LIMIT=60        # per visitor
DB_SSLMODE=require                # applied to remote Postgres when DATABASE_URL has no sslmode
DB_STATEMENT_TIMEOUT_MS=0         # 0 = off. Leave off behind PgBouncer / Supabase pooler.
