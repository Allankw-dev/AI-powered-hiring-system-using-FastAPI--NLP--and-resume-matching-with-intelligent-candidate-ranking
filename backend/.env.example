# ───────────── REQUIRED ─────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ───────────── Email (needed for admin 2FA codes + password resets) ─────────────
# Option A (recommended on Render - uses HTTPS, SMTP ports may be blocked):
RESEND_API_KEY=
EMAIL_FROM=AI Hiring System <onboarding@resend.dev>
# Option B: Gmail SMTP with an App Password
ADMIN_EMAIL=
ADMIN_EMAIL_PASSWORD=

# ───────────── Chat assistant (set one; Claude is used first) ─────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ───────────── Optional ─────────────
ENVIRONMENT=production            # production | development
FRONTEND_URL=https://ai-powered-hiring-system.streamlit.app
CORS_ORIGINS=*                    # or https://your-app.streamlit.app
OTP_DELIVERY=email                # email | log (log = print code in server logs; break-glass only)
TRUSTED_PROXY_HOPS=1              # raise to 2 if /admin/client-ip shows the same IP for everyone
MAX_UPLOAD_MB=5
CHAT_DAILY_LIMIT=1000
